{
  "version": 2,
  "builds": [
    { "src": "api/index.php", "use": "vercel-php@0.9.0" },
    { "src": "assets/**", "use": "@vercel/static" },
    { "src": "uploads/**", "use": "@vercel/static" },
    { "src": "views/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/(.*)\\.(css|js|png|jpg|jpeg|gif|svg|ico|webp|woff2?|ttf|eot)$", "dest": "/$1.$2" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
